# syntax=docker/dockerfile:1
# ─────────────────────────────────────────────────────────────────────────────
# Issuer service — the key-holding, Chromium-rendering admin service.
# Build context = repo root:  docker build -f infra/Dockerfile.issuer -t issuer .
# Runtime: Cloud Run, asia-east1, scale-to-zero.
# ─────────────────────────────────────────────────────────────────────────────
FROM node:22-bookworm-slim AS base
ENV PNPM_HOME=/pnpm PATH=$PNPM_HOME:$PATH
RUN corepack enable
WORKDIR /repo

# ── Build: install all workspace deps, compile every package, prune to issuer ──
FROM base AS build
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json tsconfig.base.json ./
COPY packages ./packages
COPY services ./services
RUN --mount=type=cache,id=pnpm,target=/pnpm/store pnpm install --frozen-lockfile
RUN pnpm -r build
# Produce a self-contained /app (issuer + its built workspace deps, prod only).
RUN pnpm --filter=@dmjone/issuer deploy --prod --legacy /app

# ── Runtime: system Chromium for Puppeteer (no bundled download) ──────────────
FROM base AS runtime
RUN apt-get update && apt-get install -y --no-install-recommends \
      chromium \
      fonts-liberation libnss3 libatk1.0-0 libatk-bridge2.0-0 libcups2 \
      libdrm2 libxkbcommon0 libxcomposite1 libxdamage1 libxfixes3 libxrandr2 \
      libgbm1 libasound2 ca-certificates \
  && rm -rf /var/lib/apt/lists/*
ENV NODE_ENV=production \
    SERVICE_ROLE=issuer \
    PORT=8080 \
    PUPPETEER_SKIP_DOWNLOAD=true \
    PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
WORKDIR /app
COPY --from=build /app /app
USER node
EXPOSE 8080
CMD ["node", "dist/main.js"]
