# ============================================================================
# dmj.one Trust Services — environment contract
# Copy to .env and fill. Validated by zod at startup (crash on misconfig).
# Secrets left blank are generated + encrypted on first run. NEVER commit .env.
# ============================================================================

# ── Runtime ──────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
# Which service this process runs as: "issuer" | "verify"
SERVICE_ROLE=issuer
PORT=8080

# ── GCP ──────────────────────────────────────────────────────────────────
GCP_PROJECT_ID=dmjone
GCP_REGION=asia-east1
FIRESTORE_DATABASE_ID=(default)
# Local dev only — Cloud Run uses Application Default Credentials:
FIRESTORE_EMULATOR_HOST=
GOOGLE_APPLICATION_CREDENTIALS=

# ── Public URLs ──────────────────────────────────────────────────────────
ISSUER_PUBLIC_URL=https://issue.dmj.one
VERIFY_PUBLIC_URL=https://verify.dmj.one

# ── Issuer identity (printed on certs + §63 cert + X.509 subject) ─────────
TRUST_SERVICE_NAME=dmj.one Trust Services
TRUST_SERVICE_OU=Document Signing
TRUST_SERVICE_COUNTRY=IN
ISSUER_LEGAL_NAME=dmj.one (independent educational initiative)
ISSUER_CONTACT_EMAIL=contact@dmj.one
ISSUER_CONTACT_PHONE=+91 79799 30293

# ── Admin auth: WebAuthn ─────────────────────────────────────────────────
WEBAUTHN_RP_ID=issue.dmj.one
WEBAUTHN_RP_NAME=dmj.one Trust Services Admin
WEBAUTHN_ORIGIN=https://issue.dmj.one
# Gates the FIRST admin passkey registration (+ re-registration after a factory
# reset). Its OWN secret — never reuse SESSION_SECRET/MASTER_ENCRYPTION_KEY.
# Required in production; generate with: openssl rand -base64 24
ADMIN_SETUP_TOKEN=  # pragma: allowlist secret

# ── Security ─────────────────────────────────────────────────────────────
# Base64, 32 bytes. Master key encrypting all secrets at rest. Blank = generated on first run.
MASTER_ENCRYPTION_KEY=
# Argon2id (password hashing + recovery codes)
ARGON2_MEMORY_KIB=19456
ARGON2_ITERATIONS=2
ARGON2_PARALLELISM=1
# Admin session
# Generate with: openssl rand -base64 32
SESSION_SECRET=CHANGE_ME_min_16_chars  # pragma: allowlist secret
ADMIN_SESSION_TTL_SECONDS=900
# Brute-force lockout
MAX_AUTH_FAILURES=10

# ── Signing keys (generated + stored encrypted in Secret Manager; leave blank) ──
PADES_SIGNING_CERT=
PADES_SIGNING_KEY=
MLDSA_PUBLIC_KEY=
MLDSA_SECRET_KEY=
LOG_SIGNING_PUBLIC_KEY=
LOG_SIGNING_SECRET_KEY=

# ── Transparency log anchor (free, public, immutable) ────────────────────
ANCHOR_GITHUB_REPO=dmjone/trust-anchor
ANCHOR_GITHUB_TOKEN=
ANCHOR_OPENTIMESTAMPS_ENABLED=true
ANCHOR_INTERVAL_MINUTES=60

# ── Optional $0 OTP channel (NEVER SMS) ──────────────────────────────────
TELEGRAM_BOT_TOKEN=
ADMIN_TELEGRAM_CHAT_ID=
SMTP_URL=

# ── Render (issuer only) ─────────────────────────────────────────────────
# Set in container to the bundled Chromium. Local dev may use Puppeteer's download.
PUPPETEER_EXECUTABLE_PATH=
