{
  "name": "dmjone-trust-services",
  "version": "0.1.0",
  "private": true,
  "description": "dmj.one Trust Services \u2014 quantum-verifiable certificate issuing & verification suite",
  "packageManager": "pnpm@10.30.1",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "pnpm -r --if-present test",
    "dev:issuer": "pnpm --filter @dmjone/issuer dev",
    "dev:verify": "pnpm --filter @dmjone/verify dev"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "eslint": "^9.39.5",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "overrides": {
      "crypto-js": "^4.2.0"
    }
  }
}
