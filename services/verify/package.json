    "@hono/node-server": "^2.0.4",
    "@noble/hashes": "^2.2.0",
    "hono": "^4.12.23",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.0"
  }
