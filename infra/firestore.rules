rules_version = '2';

// dmj.one Trust Services — Firestore lockdown.
//
// No browser or client SDK ever talks to Firestore directly. ALL access is
// server-side through the Admin SDK (issuer-sa / verify-sa), which bypasses
// these rules entirely. Therefore the correct rule is: deny every client path.
// This is defense-in-depth — even a leaked web API key grants zero data access.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
