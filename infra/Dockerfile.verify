# syntax=docker/dockerfile:1
# ─────────────────────────────────────────────────────────────────────────────
# Verify service — public, KEYLESS, lean. No Chromium, no signing key.
# Build context = repo root:  docker build -f infra/Dockerfile.verify -t verify .
# Runtime: Cloud Run, asia-east1, scale-to-zero. Distroless + non-root.
# ─────────────────────────────────────────────────────────────────────────────
FROM node:22-bookworm-slim AS base
ENV PNPM_HOME=/pnpm PATH=$PNPM_HOME:$PATH
RUN corepack enable
WORKDIR /repo

FROM base AS build
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json tsconfig.base.json ./
COPY packages ./packages
COPY services ./services
RUN --mount=type=cache,id=pnpm,target=/pnpm/store pnpm install --frozen-lockfile
RUN pnpm -r build
RUN pnpm --filter=@dmjone/verify deploy --prod --legacy /app

# Distroless: minimal attack surface, runs as nonroot (uid 65532) by default.
FROM gcr.io/distroless/nodejs22-debian12 AS runtime
ENV NODE_ENV=production SERVICE_ROLE=verify PORT=8080
WORKDIR /app
COPY --from=build /app /app
EXPOSE 8080
CMD ["dist/main.js"]
